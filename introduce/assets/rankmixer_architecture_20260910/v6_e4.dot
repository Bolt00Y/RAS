digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.33",ranksep="0.42",splines=polyline,fontname="Arial",fontsize=18,compound=true,newrank=true];
node [shape=box,style="rounded,filled",fontname="Arial",fontsize=18,margin="0.17,0.13",penwidth=1.1];
edge [color="#607388",fontcolor="#3b5065",fontname="Arial",fontsize=13,arrowsize=0.75,penwidth=1.15];
"input" [label="三桶字段输入\n1234字段 × 17维",width="2.472",fillcolor="#e9f5ef",color="#6a9e84",fontcolor="#174b34"];
"bn" [label="入口分桶 BN\ncommon / item / creative",width="3.897",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"ci_senet" [label="common/item 字段 SENet\ncommon 依赖自身\nitem 依赖 common+item",width="3.527",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"a_senet" [label="creative 独立 SENet\ngate 仅依赖 creative",width="3.197",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"groups" [label="主干固定语义组\n10 common + 21 item\n无 creative Local",width="3.172",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"local" [label="Local：Linear + GELU\n31 × 256 + RMSNorm",width="3.277",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"raw_ci" [label="取 BN 后 common/item\nSENet 前，共 20740维",width="3.237",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"global" [label="Global 投影\n20740 → 256 → 256\nRMSNorm\n首层GELU，次层线性",width="3.092",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"concat" [label="31 Local + 1 Global\n32 × 256",width="3.172",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"block1" [label="Block 1：双 SwiGLU\nD256 / M704\nPreNorm：RMSNorm",width="2.947",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"block2" [label="Block 2：双 SwiGLU\nD256 / M704\nPreNorm：RMSNorm",width="2.947",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"norm" [label="最终共享 LayerNorm\nγ / β：[256]",width="2.867",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"mean" [label="MeanPool\n32 × 256 → 256",width="2.552",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"a_fc1" [label="creative：238 → 256\nDense + BN\n参数化 Swish",width="3.237",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"a_fc2" [label="creative：256 → 32\nDense + BN\n参数化 Swish",width="3.092",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"fuse" [label="直接拼接\n256 + 32 = 288维\n拼接前无额外 Norm",width="2.697",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"head1" [label="任务头：288 → 256\nDense + BN + GELU",width="2.882",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"head2" [label="任务头：256 → 128\nDense + BN + GELU",width="2.882",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"logit" [label="线性层 → 1维\nLogit 裁剪 [-50,50]",width="3.092",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"output" [label="Sigmoid\nfst_CVR 预估",width="2.077",fillcolor="#244968",color="#244968",fontcolor="#ffffff"];
subgraph "cluster_main" { label="common/item 主干"; style="rounded"; color="#c5d1de"; fontcolor="#425b75"; margin=16;
"ci_senet";
"groups";
"local";
"raw_ci";
"global";
"concat";
"block1";
"block2";
"norm";
"mean";
}
subgraph "cluster_creative" { label="creative 独立旁路"; style="rounded"; color="#c5d1de"; fontcolor="#425b75"; margin=16;
"a_senet";
"a_fc1";
"a_fc2";
}
"input" -> "bn";
"bn" -> "ci_senet" [label="common/item"];
"bn" -> "a_senet" [label="creative"];
"ci_senet" -> "groups";
"groups" -> "local";
"bn" -> "raw_ci" [label="绕过 SENet"];
"raw_ci" -> "global";
"local" -> "concat";
"global" -> "concat";
"concat" -> "block1";
"block1" -> "block2";
"block2" -> "norm";
"norm" -> "mean";
"a_senet" -> "a_fc1";
"a_fc1" -> "a_fc2";
"mean" -> "fuse";
"a_fc2" -> "fuse" [label="独立 32维旁路"];
"fuse" -> "head1";
"head1" -> "head2";
"head2" -> "logit";
"logit" -> "output";
}