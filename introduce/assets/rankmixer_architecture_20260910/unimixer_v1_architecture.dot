digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.33",ranksep="0.42",splines=polyline,fontname="Arial",fontsize=18,compound=true,newrank=true];
node [shape=box,style="rounded,filled",fontname="Arial",fontsize=18,margin="0.17,0.13",penwidth=1.1];
edge [color="#607388",fontcolor="#3b5065",fontname="Arial",fontsize=13,arrowsize=0.75,penwidth=1.15];
"input" [label="三桶字段 Embedding\n共 1234 × 17",width="2.867",fillcolor="#e9f5ef",color="#6a9e84",fontcolor="#174b34"];
"bn" [label="分桶 BN\n字段级分层 SENet",width="2.537",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"groups" [label="固定语义分组\n10 common / 21 item\n1 creative，共 32 组",width="3.197",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"project" [label="每组独立 Linear → BN\n每 Token：512 维",width="3.262",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"tokens" [label="堆叠 32 × 512\n没有额外 Global Token",width="3.302",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"init" [label="双流初始化\nx₀ = y₀ = 输入 Token",width="3.447",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"block1" [label="UniMixer Block 1\n可学习混合 + 单套 pSwiGLU\n双流更新；D512 / M1024",width="3.762",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"block2" [label="UniMixer Block 2\n独立层参数\n双流更新；D512 / M1024",width="3.407",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"combine" [label="双流末端合成\nx₂ + RMSNorm(y₂)\n32 × 512",width="2.947",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"flat" [label="PureFlat\n32 × 512 → 16384",width="2.842",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"head" [label="任务头\n16384→2048→2048→256",width="3.487",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"output" [label="线性输出 → 裁剪 → Sigmoi\nd\nfst_CVR 概率",width="3.867",fillcolor="#244968",color="#244968",fontcolor="#ffffff"];
"note" [label="同时改变多项结构\n不能视为只替换 Mixing",width="3.182",fillcolor="#f5f6f8",color="#a3adb8",fontcolor="#435161",style="rounded,dashed,filled"];
"input" -> "bn";
"bn" -> "groups";
"groups" -> "project";
"project" -> "tokens";
"tokens" -> "init";
"init" -> "block1";
"block1" -> "block2";
"block2" -> "combine";
"combine" -> "flat";
"flat" -> "head";
"head" -> "output";
"note" -> "block1" [label="对照边界",style="dashed",color="#9ba8b5"];
}