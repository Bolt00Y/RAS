digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.33",ranksep="0.42",splines=polyline,fontname="Arial",fontsize=18,compound=true,newrank=true];
node [shape=box,style="rounded,filled",fontname="Arial",fontsize=18,margin="0.17,0.13",penwidth=1.1];
edge [color="#607388",fontcolor="#3b5065",fontname="Arial",fontsize=13,arrowsize=0.75,penwidth=1.15];
"input" [label="三桶字段 Embedding\n共 1234 × 17",width="2.867",fillcolor="#e9f5ef",color="#6a9e84",fontcolor="#174b34"];
"raw" [label="分桶 BN + 分层 SENet\nRaw：20978 维",width="3.157",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"dcn" [label="Base 同型两层 DCNM\nrank 500，无 Mask",width="2.867",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"cross" [label="Cross：20978 维\n保留字段坐标布局",width="2.512",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"rawgroups" [label="按 10 / 20 / 1 语义组\n收集 Raw 字段",width="3.302",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"crossgroups" [label="按相同字段 ID / 组\n收集 Cross 字段",width="2.787",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"views" [label="组内 Concat Raw / Cross\n每组输入：34 × 字段数",width="3.672",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"local" [label="独立 Linear + GELU + RMSN\norm\nLocal：31 × 512",width="3.962",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"global" [label="Cross Global\n20978→512→512\nRMSNorm：1 × 512",width="2.697",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"tokens" [label="Concat Local + Global\n32 × 512",width="3.462",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"blocks" [label="两层双 FFN Block\nD512 / M512",width="2.617",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"norm" [label="Final per-token RMSNorm\n32 × 512",width="3.752",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"gfinal" [label="末端 Global\n512 维",width="1.932",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"lfinal" [label="末端 Local\n31 × 512",width="1.800",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"pool" [label="Global 条件池化\n输出 512 维",width="2.432",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"flat" [label="Local 展平：15872 维\n压缩 + RMSNorm + 门控\n输出改为 256 维",width="3.302",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"shortcut" [label="Cross Shortcut\n20978→512\nBN + GELU",width="2.447",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"fusion" [label="四路 Concat\n512+512+256+512\n共 1792 维",width="2.592",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"head" [label="任务头\n1792→2048→2048→256",width="3.342",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"output" [label="线性输出 → 裁剪 → Sigmoi\nd\nfst_CVR 概率",width="3.867",fillcolor="#244968",color="#244968",fontcolor="#ffffff"];
"input" -> "raw";
"raw" -> "dcn";
"dcn" -> "cross";
"raw" -> "rawgroups";
"cross" -> "crossgroups";
"rawgroups" -> "views";
"crossgroups" -> "views";
"views" -> "local";
"cross" -> "global";
"local" -> "tokens";
"global" -> "tokens";
"tokens" -> "blocks";
"blocks" -> "norm";
"norm" -> "gfinal";
"norm" -> "lfinal";
"gfinal" -> "pool" [label="条件查询"];
"lfinal" -> "pool";
"lfinal" -> "flat";
"cross" -> "shortcut" [label="绕过 Token / Mixer"];
"gfinal" -> "fusion";
"pool" -> "fusion";
"flat" -> "fusion";
"shortcut" -> "fusion";
"fusion" -> "head";
"head" -> "output";
}