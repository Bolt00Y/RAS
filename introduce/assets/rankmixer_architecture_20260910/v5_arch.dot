digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.33",ranksep="0.42",splines=polyline,fontname="Arial",fontsize=18,compound=true,newrank=true];
node [shape=box,style="rounded,filled",fontname="Arial",fontsize=18,margin="0.17,0.13",penwidth=1.1];
edge [color="#607388",fontcolor="#3b5065",fontname="Arial",fontsize=13,arrowsize=0.75,penwidth=1.15];
"input" [label="三桶 Embedding\n385 / 835 / 14 ×17",width="3.027",fillcolor="#e9f5ef",color="#6a9e84",fontcolor="#174b34"];
"bn" [label="分桶 BN + 分层SENet",width="3.012",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"groups" [label="冻结哈希均衡分组\ncommon/item/creative\n10 / 20 / 1组",width="3.317",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"local" [label="同宽组独立批量投影\nGELU + per-token RMS\n31 × 1024",width="3.317",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"global" [label="三桶SENet后全量输入\n20978→1024→1024\nGELU / Linear / RMS",width="3.172",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"tokens" [label="Local + Global\nT=H=32，D=1024",width="2.447",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"bin" [label="当层输入 x",width="1.800",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"mix" [label="固定 Mixing\n交换Token与分片轴",width="2.642",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"fm" [label="RMS → pSwiGLUₘ\n1024→704→1024",width="2.657",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"addm" [label="m + Fₘ(RMS(m))\n得到 h",width="2.552",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"revert" [label="Reverting(h)\n恢复原Token布局",width="2.392",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"fo" [label="RMS → pSwiGLUₒ\n1024→704→1024",width="2.657",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"addo" [label="x + Fₒ(RMS(r))\n加回当层原始输入 x",width="2.707",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"final" [label="Final per-token RMS\n提取31 Local与1 Global",width="3.487",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"gread" [label="保留 Global\n1024维",width="1.932",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"pool" [label="Global→Query 128维\nLocal→Keys，Softmax\n条件加权池化 1024维",width="3.237",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"flat" [label="31个Local展平\n31744→512 + RMS\n可学习标量门控",width="2.697",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"join" [label="三路拼接\n1024 + 1024 + 512\n共 2560维",width="2.882",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"head" [label="MLP 2048→2048→256\nBN + GELU；Linear→1",width="3.237",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"out" [label="截断 + Sigmoid\n首次转化概率",width="2.367",fillcolor="#244968",color="#244968",fontcolor="#ffffff"];
subgraph "cluster_tokenize" { label="输入组织：31 Local + 1 Global"; style="rounded"; color="#c5d1de"; fontcolor="#425b75"; margin=16;
"groups";
"local";
"global";
"tokens";
}
subgraph "cluster_block" { label="完整 Block × 2；每层2套独立FFN"; style="rounded"; color="#c5d1de"; fontcolor="#425b75"; margin=16;
"bin";
"mix";
"fm";
"addm";
"revert";
"fo";
"addo";
}
subgraph "cluster_readout" { label="三路读出"; style="rounded"; color="#c5d1de"; fontcolor="#425b75"; margin=16;
"gread";
"pool";
"flat";
"join";
}
"input" -> "bn";
"bn" -> "groups";
"groups" -> "local";
"bn" -> "global" [label="SENet后"];
"local" -> "tokens";
"global" -> "tokens";
"tokens" -> "bin";
"bin" -> "mix";
"mix" -> "fm";
"fm" -> "addm";
"mix" -> "addm" [label="残差 m"];
"addm" -> "revert";
"revert" -> "fo";
"fo" -> "addo";
"bin" -> "addo" [label="长残差 x"];
"addo" -> "final" [label="堆叠2层后"];
"final" -> "gread" [label="Global"];
"final" -> "pool" [label="Global + Local"];
"final" -> "flat" [label="Local"];
"gread" -> "join";
"pool" -> "join";
"flat" -> "join";
"join" -> "head";
"head" -> "out";
}