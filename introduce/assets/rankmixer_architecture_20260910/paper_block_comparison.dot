"r_a" [label="X + P(X)\nLayerNorm → S",width="2.407",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"r_f" [label="Per-token FFN\nLinear→GELU→Linear",width="3.237",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"r_b" [label="S + FFN(S)\nLayerNorm",width="1.867",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"r_y" [label="Block 输出 Y",width="2.077",fillcolor="#244968",color="#244968",fontcolor="#ffffff"];
"t_x" [label="输入 X",width="1.800",fillcolor="#e9f5ef",color="#6a9e84",fontcolor="#174b34"];
"t_n" [label="RMSNorm(X)",width="1.867",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"t_p" [label="Mixing",width="1.800",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"t_f" [label="第一前馈阶段\npSwiGLU / S-P MoE",width="2.882",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"t_r" [label="Reverting",width="1.800",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"t_a" [label="加回 X\n第一段输出 U",width="1.957",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"t_n2" [label="RMSNorm(U)",width="1.867",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"t_f2" [label="第二前馈阶段\npSwiGLU / S-P MoE",width="2.882",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"t_a2" [label="加回 U",width="1.800",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"t_y" [label="Block 输出 Y",width="2.077",fillcolor="#244968",color="#244968",fontcolor="#ffffff"];
"s_x" [label="输入 X",width="1.800",fillcolor="#e9f5ef",color="#6a9e84",fontcolor="#174b34"];
"s_p" [label="先 Mixing\nm = P(X)",width="1.800",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"s_n" [label="后 RMSNorm(m)",width="2.262",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"s_f" [label="第一套 pSwiGLU",width="2.327",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"s_a" [label="加回 m\nh = m + update",width="2.447",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"s_r" [label="Reverting(h)\n得到 r",width="2.157",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"s_n2" [label="RMSNorm(r)",width="1.867",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"s_f2" [label="第二套 pSwiGLU",width="2.327",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"s_a2" [label="加回原始输入 X\n不是加回 r",width="2.207",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"s_y" [label="Block 输出 Y",width="2.077",fillcolor="#244968",color="#244968",fontcolor="#ffffff"];
subgraph "cluster_r_" { label="原始 RankMixer：1 个 FFN 阶段"; style="rounded"; color="#c5d1de"; fontcolor="#425b75"; margin=16;
"r_x";
"r_p";
"r_a";
"r_f";
"r_b";
"r_y";
}
