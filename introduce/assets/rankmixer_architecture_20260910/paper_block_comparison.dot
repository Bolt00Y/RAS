"t_a" -> "t_n2";
"t_n2" -> "t_f2";
"t_f2" -> "t_a2";
"t_a" -> "t_a2" [label="残差 U"];
"t_a2" -> "t_y";
"s_x" -> "s_p";
"s_p" -> "s_n";
"s_n" -> "s_f";
"s_f" -> "s_a";
"s_p" -> "s_a" [label="残差 m"];
"s_a" -> "s_r";
"s_r" -> "s_n2";
"s_n2" -> "s_f2";
"s_f2" -> "s_a2";
