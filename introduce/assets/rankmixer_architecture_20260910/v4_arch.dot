digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.33",ranksep="0.42",splines=polyline,fontname="Arial",fontsize=18,compound=true,newrank=true];
node [shape=box,style="rounded,filled",fontname="Arial",fontsize=18,margin="0.17,0.13",penwidth=1.1];
edge [color="#607388",fontcolor="#3b5065",fontname="Arial",fontsize=13,arrowsize=0.75,penwidth=1.15];
"input" [label="三桶 Embedding\n385 / 835 / 14 ×17",width="3.027",fillcolor="#e9f5ef",color="#6a9e84",fontcolor="#174b34"];
"bn" [label="分桶 BN + 分层SENet",width="3.012",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"token" [label="固定语义5/10/1组\n独立投影 + GELU\nT=16，D=768",width="2.537",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"bin" [label="当前 Block 输入 x",width="2.722",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"mix" [label="固定 Mixing",width="1.932",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"ln1" [label="x + Mixing(x) → LN\n得到 s",width="3.132",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"ffn" [label="Per-token FFN\n768→1536→768",width="2.367",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"ln2" [label="s + FFN(s) → LN",width="2.697",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"pool" [label="门控池化\n输出768维",width="1.800",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"bucket" [label="前置三桶均值及两两乘积\n投影768 + LN + 门控",width="3.167",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"q" [label="前置 Query Token\nLN → Linear 128",width="2.697",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"it" [label="前置目标 Token，两路\n文本相关性；身份/质量\n分别 LN → Linear128",width="3.197",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"pair" [label="两路分别拼接\n[qᵣ,iᵣ,qᵣ⊙iᵣ,qᵣ−iᵣ\n]\n512维",width="3.867",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"pairffn" [label="两路独立交叉变换\n512→128，GELU\n128→768，零初始化",width="2.787",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"gate" [label="两路样本门控\n[qᵣ,iᵣ,qᵣ⊙iᵣ]\nLinear → Sigmoid",width="2.842",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"res" [label="门控 × 交叉输出\n两路残差求和，768维",width="2.852",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"fusion" [label="Pool + 桶间残差\n+ Q–I残差 → LN",width="2.577",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"head" [label="线性 768→1\n截断 + Sigmoid",width="2.367",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"out" [label="首次转化概率",width="1.917",fillcolor="#244968",color="#244968",fontcolor="#ffffff"];
subgraph "cluster_block" { label="保留：Post-Norm Block × 2"; style="rounded"; color="#c5d1de"; fontcolor="#425b75"; margin=16;
"bin";
"mix";
"ln1";
"ffn";
"ln2";
}
subgraph "cluster_qi" { label="新增：两路定向 Q–I 交叉"; style="rounded"; color="#c5d1de"; fontcolor="#425b75"; margin=16;
"q";
"it";
"pair";
"pairffn";
"gate";
"res";
}
"input" -> "bn";
"bn" -> "token";
"token" -> "bin";
"bin" -> "mix";
"mix" -> "ln1";
"bin" -> "ln1" [label="残差"];
"ln1" -> "ffn";
"ffn" -> "ln2";
"ln1" -> "ln2" [label="残差 s"];
"ln2" -> "pool" [label="堆叠2层后"];
"token" -> "bucket";
"token" -> "q" [label="Mixer前"];
"token" -> "it" [label="Mixer前"];
"q" -> "pair";
"it" -> "pair";
"pair" -> "pairffn";
"q" -> "gate";
"it" -> "gate";
"pairffn" -> "res";
"gate" -> "res";
"pool" -> "fusion";
"bucket" -> "fusion";
"res" -> "fusion";
"fusion" -> "head";
"head" -> "out";
}