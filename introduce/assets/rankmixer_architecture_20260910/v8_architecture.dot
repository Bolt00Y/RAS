digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.33",ranksep="0.42",splines=polyline,fontname="Arial",fontsize=18,compound=true,newrank=true];
node [shape=box,style="rounded,filled",fontname="Arial",fontsize=18,margin="0.17,0.13",penwidth=1.1];
edge [color="#607388",fontcolor="#3b5065",fontname="Arial",fontsize=13,arrowsize=0.75,penwidth=1.15];
"input" [label="三桶字段 Embedding\n共 1234 × 17",width="2.867",fillcolor="#e9f5ef",color="#6a9e84",fontcolor="#174b34"];
"raw" [label="分桶 BN + 分层 SENet\nRaw：20978 维",width="3.157",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"dcn" [label="新增两层 Masked DCN\nrank 500 / mask 隐层 250",width="3.817",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"cross" [label="Cross：20978 维\n按原桶和字段坐标拆回",width="2.917",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"local" [label="10 / 20 / 1 语义组\n独立 Linear + GELU + RMSN\norm\nLocal：31 × 512",width="3.962",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"global" [label="Raw Global 投影\n20978→512→512\nRMSNorm：1 × 512",width="2.697",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"cat" [label="Concat Local + Global\n32 × 512",width="3.462",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"blocks" [label="两层双 FFN Block\nMixing / Reverting\nSwiGLU 中间宽度：512",width="3.117",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"norm" [label="Final per-token RMSNorm\n32 × 512",width="3.752",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"gfinal" [label="末端 Global Token\n512 维",width="2.802",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"lfinal" [label="末端 Local Tokens\n31 × 512",width="2.802",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"pool" [label="Global 条件加权池化\n输出 512 维",width="2.932",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"flat" [label="Local 展平：15872 维\n压缩 + RMSNorm + 门控\n输出 512 维",width="3.302",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"concat" [label="三路 Concat\n512 + 512 + 512 = 1536",width="3.607",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"head" [label="任务头\n1536→2048→2048→256",width="3.342",fillcolor="#edf4fc",color="#7290b1",fontcolor="#183a5e"];
"output" [label="线性输出 → 裁剪 → Sigmoi\nd\nfst_CVR 概率",width="3.867",fillcolor="#244968",color="#244968",fontcolor="#ffffff"];
"input" -> "raw";
"raw" -> "dcn";
"dcn" -> "cross";
"cross" -> "local";
"raw" -> "global" [label="绕过 DCN"];
"local" -> "cat";
"global" -> "cat";
"cat" -> "blocks";
"blocks" -> "norm";
"norm" -> "gfinal";
"norm" -> "lfinal";
"gfinal" -> "pool" [label="条件查询"];
"lfinal" -> "pool" [label="被汇总的 Local"];
"lfinal" -> "flat";
"gfinal" -> "concat";
"pool" -> "concat";
"flat" -> "concat";
"concat" -> "head";
"head" -> "output";
}