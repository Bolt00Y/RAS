digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.33",ranksep="0.42",splines=polyline,fontname="Arial",fontsize=18,compound=true,newrank=true];
node [shape=box,style="rounded,filled",fontname="Arial",fontsize=18,margin="0.17,0.13",penwidth=1.1];
edge [color="#607388",fontcolor="#3b5065",fontname="Arial",fontsize=13,arrowsize=0.75,penwidth=1.15];
"x" [label="当前 x_l\n32 × 512",width="1.800",fillcolor="#e9f5ef",color="#6a9e84",fontcolor="#174b34"];
"y" [label="当前 y_l\n32 × 512",width="1.800",fillcolor="#e9f5ef",color="#6a9e84",fontcolor="#174b34"];
"ynorm" [label="RMSNorm(y_l)",width="2.157",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"u" [label="相加：u = x_l + RMS(y_l)\n32 × 512",width="3.777",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"reshape" [label="坐标重组\n16384 维 → 512 × 32",width="3.237",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"params" [label="块间 U Vᵀ：rank 128\n块内：8 个基矩阵加权",width="3.157",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"weights" [label="对称化、温度、指数\n10 轮行列归一化\n最终对称化",width="2.667",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"intra" [label="先块内混合\n每块使用 32 × 32 矩阵",width="3.222",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"inter" [label="再块间混合\n使用 512 × 512 矩阵",width="3.012",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"mixed" [label="恢复 Token 布局\nM(u)：32 × 512",width="2.432",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"addmix" [label="相加：u + M(u)",width="2.327",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"rmsmix" [label="RMSNorm(u + M(u))",width="2.882",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"ffn" [label="单套 Per-token SwiGLU\nD512 → M1024 → D512\n输出 f_l",width="3.382",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"xadd" [label="相加：x_l + f_l",width="2.472",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"xrms" [label="RMSNorm\nx_l₊₁ = RMS(x_l + f_l)",width="3.817",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"yadd" [label="相加：y_l + f_l\ny_l₊₁ 保留未归一化累积",width="3.497",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"nextx" [label="下一层 x_l₊₁\n32 × 512",width="2.247",fillcolor="#244968",color="#244968",fontcolor="#ffffff"];
"nexty" [label="下一层 y_l₊₁\n32 × 512",width="2.247",fillcolor="#244968",color="#244968",fontcolor="#ffffff"];
"finaly" [label="最后一层后的 RMS(y₂)",width="3.182",fillcolor="#fff0d4",color="#ca8425",fontcolor="#71400d"];
"final" [label="两层后相加\nx₂ + RMS(y₂)\n送入 PureFlat / 任务头",width="3.407",fillcolor="#244968",color="#244968",fontcolor="#ffffff"];
subgraph "cluster_mixing" { label="UniMixing-Lite：块内 → 块间"; style="rounded"; color="#c5d1de"; fontcolor="#425b75"; margin=16;
"reshape";
"params";
"weights";
"intra";
"inter";
"mixed";
}
subgraph "cluster_states" { label="同一个 f_l 更新两条状态流"; style="rounded"; color="#c5d1de"; fontcolor="#425b75"; margin=16;
"xadd";
"xrms";
"yadd";
"nextx";
"nexty";
}
"y" -> "ynorm";
"ynorm" -> "u";
"x" -> "u";
"u" -> "reshape";
"params" -> "weights" [label="模型参数"];
"weights" -> "intra" [label="块内矩阵"];
"weights" -> "inter" [label="块间矩阵"];
"reshape" -> "intra";
"intra" -> "inter";
"inter" -> "mixed";
"mixed" -> "addmix";
"u" -> "addmix" [label="混合残差"];
"addmix" -> "rmsmix";
"rmsmix" -> "ffn";
"ffn" -> "xadd";
"x" -> "xadd" [label="x 流残差"];
"xadd" -> "xrms";
"xrms" -> "nextx";
"ffn" -> "yadd";
"y" -> "yadd" [label="y 流累积"];
"yadd" -> "nexty";
"nextx" -> "final" [label="最后一层后"];
"nexty" -> "finaly" [label="最后一层后"];
"finaly" -> "final";
}